PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/branchpruner?schema=public"
JWT_SECRET="branchpruner_super_secret_jwt_access_token_key_32_chars"
JWT_REFRESH_SECRET="branchpruner_super_secret_jwt_refresh_token_key_32_chars"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CSRF_SECRET="branchpruner_super_secret_csrf_secret_key_32_chars"

APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# Git & Slack Integration Modes
GIT_PROVIDER_MODE="mock"
SLACK_MODE="mock"

# OAuth 2.0 Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3001/api/auth/github/callback"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Email Configuration (mailpit | smtp | resend | sendgrid | console)
EMAIL_PROVIDER="mailpit"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
EMAIL_FROM="BranchPruner <no-reply@branchpruner.io>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# Webhooks & Tokens
GITHUB_WEBHOOK_SECRET="branchpruner_github_webhook_secret_key"
GITLAB_API_URL="https://gitlab.com/api/v4"
GITLAB_TOKEN=""
SLACK_BOT_TOKEN=""
SLACK_DEFAULT_CHANNEL="#git-hygiene"
