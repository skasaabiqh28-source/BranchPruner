PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/branchpruner?schema=public"
JWT_SECRET="replace_with_at_least_32_characters_random_secret_access"
JWT_REFRESH_SECRET="replace_with_at_least_32_characters_random_secret_refresh"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CSRF_SECRET="replace_with_at_least_32_characters_random_secret_csrf"

APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# Git & Slack Integration Modes (mock | live)
GIT_PROVIDER_MODE="mock"
SLACK_MODE="mock"

# OAuth 2.0 Providers (GitHub & Google)
# Create a GitHub OAuth App: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3001/api/auth/github/callback"

# Create a Google OAuth 2.0 Web Client: https://console.cloud.google.com/apis/credentials
# - Authorized JavaScript origins: http://localhost:3000, http://localhost:3001
# - Authorized redirect URIs: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Email Configuration (mailpit | smtp | resend | sendgrid | console)
# For local development with Mailpit in Docker, leave defaults (localhost:1025). Web UI: http://localhost:8025
EMAIL_PROVIDER="mailpit"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
EMAIL_FROM="BranchPruner <no-reply@branchpruner.io>"

# Resend API Key (Optional if EMAIL_PROVIDER=resend)
RESEND_API_KEY=""

# SendGrid API Key (Optional if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=""

# Webhooks & Tokens
GITHUB_WEBHOOK_SECRET="branchpruner_github_webhook_secret_key"
GITLAB_API_URL="https://gitlab.com/api/v4"
GITLAB_TOKEN=""
SLACK_BOT_TOKEN=""
SLACK_DEFAULT_CHANNEL="#git-hygiene"
