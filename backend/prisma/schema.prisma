datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  avatarUrl           String?
  passwordHash        String?
  emailVerified       Boolean              @default(false)
  emailVerifiedAt     DateTime?
  authProviders       String[]             @default([])
  workspaces          Workspace[]          @relation("WorkspaceOwner")
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts       OAuthAccount[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Workspace {
  id                String             @id @default(cuid())
  name              String
  ownerId           String
  owner             User               @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  settings          Settings?
  repositories      Repository[]
  integrations      Integration[]
  protectedPatterns ProtectedPattern[]
  auditEvents       AuditEvent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Settings {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dryRun                Boolean   @default(true)
  staleAfterDays        Int       @default(30)
  autoPrune             Boolean   @default(false)
  remediationWindowDays Int       @default(7)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Repository {
  id            String     @id @default(cuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider      String     @default("github") // github | gitlab
  fullName      String
  defaultBranch String     @default("main")
  externalId    String?
  trackedAt     DateTime   @default(now())
  branches      Branch[]
  snapshots     Snapshot[]

  @@unique([workspaceId, fullName])
  @@index([workspaceId])
}

model Branch {
  id             String     @id @default(cuid())
  repositoryId   String
  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name           String
  author         String
  lastCommitSha  String
  lastCommitAt   DateTime
  status         String     @default("active") // active | flagged | kept | pruned | protected
  flaggedAt      DateTime?
  deadlineAt     DateTime?
  keptUntil      DateTime?
  warnedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([repositoryId, name])
  @@index([repositoryId, status])
  @@index([status, deadlineAt])
}

model Snapshot {
  id                String     @id @default(cuid())
  repositoryId      String
  repository        Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  branchName        String
  archivedCommitSha String
  archiveRef        String
  prunedAt          DateTime   @default(now())
  prunedBy          String     @default("user") // user | scheduler
  status            String     @default("archived") // archived | restored
  restoredAt        DateTime?

  @@index([repositoryId])
  @@index([status])
}

model Integration {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider       String    // github | gitlab | slack
  status         String    @default("disconnected") // connected | disconnected
  connectedAs    String?
  encryptedToken String?
  config         Json?
  lastSyncedAt   DateTime?

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model ProtectedPattern {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pattern     String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, pattern])
  @@index([workspaceId])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  type        String
  payload     Json
  dryRun      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, tokenHash])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   // github | google
  providerUserId String
  email          String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}
